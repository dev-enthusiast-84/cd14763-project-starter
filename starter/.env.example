# AWS Configuration
# DO NOT commit the .env file with actual values to version control
# Copy this file to .env and fill in your values

# Gateway URL format: https://<alias>.gateway.bedrock-agentcore.<region>.amazonaws.com/mcp
GATEWAY_URL=https://your-gateway.gateway.bedrock-agentcore.us-east-1.amazonaws.com/mcp

# Knowledge Base ID (10-character alphanumeric string)
KB_ID=XXXXXXXXXX

# AWS Region
REGION=us-east-1

# AgentCore Memory ID (format: Name-RandomID)
MEMORY_ID=YourMemoryName-XXXXXXXXXX
